{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 120000,
      "url": ["http://127.0.0.1:3000/", "http://127.0.0.1:3000/platform"],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.96 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "total-byte-weight": ["error", { "maxNumericValue": 614400 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 409600 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
